<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="mobile_platform" params="prefix:=''">

    <link name="${prefix}mobile_base_link">

      <visual>
        <origin xyz="0 0 0.25"/>
        <geometry>
          <box size="0.75 0.55 0.38"/>
        </geometry>

        <material name="Black">
          <color rgba="0.2 0.2 0.8 1"/>
        </material>

      </visual>

      <collision>
        <origin xyz="0 0 0.225"/>
        <geometry>
          <box size="0.75 0.55 0.38"/>
        </geometry>
      </collision>

      <inertial>

        <origin xyz="0 0 0.225"/>

        <mass value="100"/>

        <inertia
            ixx="5.4"
            iyy="8.4"
            izz="13.5"
            ixy="0"
            ixz="0"
            iyz="0"/>

      </inertial>

    </link>

    <link name="${prefix}front_right_wheel_link">

      <visual>
        <origin rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="0.10" length="0.05"/>
        </geometry>

        <material name="Black">
          <color rgba="0.05 0.05 0.05 1"/>
        </material>

      </visual>

      <collision>
        <origin rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="0.10" length="0.05"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="2"/>
        <origin xyz="0 0 0"/>
        <inertia
          ixx="0.01"
          iyy="0.01"
          izz="0.01"
          ixy="0"
          ixz="0"
          iyz="0"/>
      </inertial>
    </link>

      <joint
          name="${prefix}front_right_wheel_joint"
          type="continuous">

          <parent link="${prefix}mobile_base_link"/>

          <child link="${prefix}front_right_wheel_link"/>

          <origin
              xyz="0.35 -0.3 0.10"
              rpy="0 0 0"/>

          <axis xyz="0 1 0"/>

      </joint>

    <link name="${prefix}rear_right_wheel_link">

      <visual>
        <origin rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="0.10" length="0.05"/>
        </geometry>

        <material name="Black">
          <color rgba="0.05 0.05 0.05 1"/>
        </material>

      </visual>

      <collision>
        <origin rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="0.10" length="0.05"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="2"/>
        <origin xyz="0 0 0"/>
        <inertia
          ixx="0.01"
          iyy="0.01"
          izz="0.01"
          ixy="0"
          ixz="0"
          iyz="0"/>
      </inertial>
    </link>
      <joint
          name="${prefix}rear_right_wheel_joint"
          type="continuous">

          <parent link="${prefix}mobile_base_link"/>

          <child link="${prefix}rear_right_wheel_link"/>

          <origin
              xyz="-0.35 -0.3 0.10"
              rpy="0 0 0"/>

          <axis xyz="0 1 0"/>

      </joint>

    

    <link name="${prefix}front_left_wheel_link">

      <visual>
        <origin rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="0.10" length="0.05"/>
        </geometry>

        <material name="Black">
          <color rgba="0.05 0.05 0.05 1"/>
        </material>

      </visual>

      <collision>
        <origin rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="0.10" length="0.05"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="2"/>
        <origin xyz="0 0 0"/>
        <inertia
          ixx="0.01"
          iyy="0.01"
          izz="0.01"
          ixy="0"
          ixz="0"
          iyz="0"/>
      </inertial>

    </link>

      <joint
          name="${prefix}front_left_wheel_joint"
          type="continuous">

          <parent link="${prefix}mobile_base_link"/>

          <child link="${prefix}front_left_wheel_link"/>

          <origin
              xyz="0.35 0.3 0.10"
              rpy="0 0 0"/>

          <axis xyz="0 1 0"/>

      </joint>

    <link name="${prefix}rear_left_wheel_link">

      <visual>
        <origin rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="0.10" length="0.05"/>
        </geometry>

        <material name="Black">
          <color rgba="0.05 0.05 0.05 1"/>
        </material>

      </visual>

      <collision>
        <origin rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="0.10" length="0.05"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="2"/>
        <origin xyz="0 0 0"/>
        <inertia
          ixx="0.01"
          iyy="0.01"
          izz="0.01"
          ixy="0"
          ixz="0"
          iyz="0"/>
      </inertial>

    </link>

    <joint
        name="${prefix}rear_left_wheel_joint"
        type="continuous">

        <parent link="${prefix}mobile_base_link"/>

        <child link="${prefix}rear_left_wheel_link"/>

        <origin
            xyz="-0.35 0.3 0.10"
            rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

    </joint>

    <link name="${prefix}lidar_link">

      <visual>

        <geometry>
          <cylinder radius="0.04" length="0.05"/>
        </geometry>

        <material name="Black"/>

      </visual>

      <collision>

        <geometry>
          <cylinder radius="0.04" length="0.05"/>
        </geometry>

      </collision>

      <inertial>

        <mass value="0.2"/>

        <origin xyz="0 0 0"/>

        <inertia
          ixx="0.0001"
          iyy="0.0001"
          izz="0.0001"
          ixy="0"
          ixz="0"
          iyz="0"/>

      </inertial>

    </link>

    <joint
        name="${prefix}lidar_joint"
        type="fixed">

        <parent link="${prefix}mobile_base_link"/>

        <child link="${prefix}lidar_link"/>

        <!-- encima del robot -->

        <origin xyz="0 0.20 0.20"/>

    </joint>

    <link name="${prefix}basket_base">

      <visual>
        <origin xyz="0 0 0"/>
        <geometry>
          <box size="0.45 0.35 0.02"/>
        </geometry>

        <material name="Brown">
          <color rgba="0.55 0.30 0.15 1"/>
        </material>

      </visual>

      <collision>
        <origin xyz="0 0 0"/>
        <geometry>
          <box size="0.45 0.35 0.02"/>
        </geometry>
      </collision>

      <inertial>
          <mass value="2"/>
          <origin xyz="0 0 0"/>
          <inertia
              ixx="0.05"
              iyy="0.05"
              izz="0.05"
              ixy="0"
              ixz="0"
              iyz="0"/>
      </inertial>

    </link>

    <joint
        name="${prefix}basket_base_joint"
        type="fixed">

        <parent link="${prefix}mobile_base_link"/>
        <child link="${prefix}basket_base"/>

        <origin xyz="-0.10 -0.1 0.43"/>

    </joint>


    <link name="${prefix}basket_left">

      <visual>

        <geometry>
          <box size="0.45 0.02 0.30"/>
        </geometry>

      </visual>

      <collision>

        <geometry>
          <box size="0.45 0.02 0.30"/>
        </geometry>

      </collision>

    </link>

    <joint name="basket_left_joint" type="fixed">
        <parent link="${prefix}basket_base"/>
        <child link="basket_left"/>
        <origin xyz="0 0.165 0.15"/>
    </joint>

    <link name="${prefix}basket_right">
      <visual>

        <geometry>
          <box size="0.45 0.02 0.30"/>
        </geometry>

      </visual>

      <collision>

        <geometry>
          <box size="0.45 0.02 0.30"/>
        </geometry>

      </collision>

    </link>

    <joint name="basket_right_joint" type="fixed">
        <parent link="${prefix}basket_base"/>
        <child link="basket_right"/>
        <origin xyz="0 -0.165 0.15"/>
    </joint>

    <link name="${prefix}basket_front">
      <visual>

        <geometry>
          <box size="0.02 0.35 0.30"/>
        </geometry>

      </visual>

      <collision>

        <geometry>
          <box size="0.02 0.35 0.30"/>
        </geometry>

      </collision>

    </link>

    <joint name="basket_front_joint" type="fixed">
        <parent link="${prefix}basket_base"/>
        <child link="basket_front"/>
        <origin xyz="0.215 0 0.15"/>
    </joint>

    <link name="${prefix}basket_back">
      <visual>

        <geometry>
          <box size="0.02 0.35 0.30"/>
        </geometry>

      </visual>

      <collision>

        <geometry>
          <box size="0.02 0.35 0.30"/>
        </geometry>

      </collision>

    </link>

        <joint name="basket_back_joint" type="fixed">
            <parent link="${prefix}basket_base"/>
            <child link="basket_back"/>
            <origin xyz="-0.215 0 0.15"/>
        </joint>

        <link name="${prefix}imu_link">

      <visual>
        <geometry>
          <box size="0.04 0.04 0.01"/>
        </geometry>

        <material name="Blue">
          <color rgba="0 0 1 1"/>
        </material>

      </visual>

    </link>

    <joint
        name="${prefix}imu_joint"
        type="fixed">

        <parent link="${prefix}mobile_base_link"/>
        <child link="${prefix}imu_link"/>

        <origin xyz="0 0 0.40"/>

    </joint>
  </xacro:macro>

</robot>